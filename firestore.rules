rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mỗi người chỉ đọc/ghi hồ sơ của chính mình (ghi nhớ mình thuộc nhà nào).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mã nhà: người đã đăng nhập tra được mã; chỉ tạo mới, không sửa hay xoá.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Nhà của hai người.
    match /couples/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        // thành viên được sửa thông tin nhà, nhưng không đổi danh sách thành viên
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        ||
        // người thứ hai vào nhà bằng mã: chỉ thêm đúng mình, tối đa 2 người
        (resource.data.members.size() < 2
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.code == resource.data.code)
      );

      // Toàn bộ dữ liệu trong nhà: chỉ hai thành viên đọc và ghi.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
      }
    }
  }
}
