rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mỗi người chỉ đọc/ghi hồ sơ của chính mình (ghi nhớ mình thuộc nhà nào).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mã nhà: người đã đăng nhập tra được mã; tạo mới được;
    // chỉ thành viên của nhà đó mới xoá được mã (khi bỏ nhà).
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.cid)).data.members;
    }

    // Nhà của hai người.
    match /couples/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        // thành viên sửa thông tin nhà, không đổi danh sách thành viên
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        ||
        // rời nhà: chỉ bỏ đúng mình ra
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.code == resource.data.code)
        ||
        // bạn ấy mất tài khoản: người còn lại mời tài khoản cũ ra
        (request.auth.uid in resource.data.members
          && resource.data.members.size() == 2
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.code == resource.data.code)
        ||
        // người thứ hai vào nhà bằng mã: nhà đang có đúng 1 người, chỉ thêm đúng mình
        (resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.code == resource.data.code
          && request.resource.data.roles == resource.data.roles)
      );

      // Cutover candidate: clients read opened history using an opened == true query.
      // The migration keeps originals under restricted access.
      match /gifts/{giftId} {
        allow get, list: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members
          && resource.data.opened == true;
      }

      // M3 candidate. Metadata may be listed without downloading either content or images.
      match /giftEnvelopes/{giftId} {
        function house() {
          return get(/databases/$(database)/documents/couples/$(cid)).data.members;
        }
        function member() {
          return request.auth != null && request.auth.uid in house();
        }
        function envelopePath() {
          return /databases/$(database)/documents/couples/$(cid)/giftEnvelopes/$(giftId);
        }
        function payloadPath() {
          return /databases/$(database)/documents/couples/$(cid)/giftEnvelopes/$(giftId)/private/content;
        }
        function validEnvelope(data) {
          return data.keys().hasOnly(['fromUid', 'toUid', 'createdAt', 'unlockAt', 'label'])
            && data.fromUid == request.auth.uid
            && data.toUid is string && data.toUid in house() && data.toUid != data.fromUid
            && data.createdAt == request.time && data.unlockAt is timestamp
            && data.get('label', '') is string && data.get('label', '').size() <= 100;
        }
        function photoAt(photos, index) {
          return photos.size() <= index || (photos[index] is bytes && photos[index].size() > 0
            && photos[index].size() <= 300000);
        }
        function validPayload(data) {
          return data.keys().hasOnly(['note', 'photos'])
            && data.note is string && data.note.size() <= 800
            && data.photos is list && data.photos.size() <= 3
            && (data.note.size() > 0 || data.photos.size() > 0)
            && photoAt(data.photos, 0) && photoAt(data.photos, 1) && photoAt(data.photos, 2);
        }

        function senderMayCancel(data) {
          return data.fromUid == request.auth.uid
            && request.time < data.unlockAt && !('openedAt' in data);
        }
        allow get, list: if member();
        allow create: if member() && validEnvelope(request.resource.data)
          && !exists(payloadPath()) && existsAfter(payloadPath());
        allow delete: if member() && senderMayCancel(resource.data) && !existsAfter(payloadPath());
        allow update: if member() && resource.data.toUid == request.auth.uid
          && request.time >= resource.data.unlockAt && !('openedAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt'])
          && request.resource.data.openedAt == request.time;

        match /private/content {
          function canRead() {
            let envelope = get(envelopePath()).data;
            return envelope.fromUid == request.auth.uid
              || (envelope.toUid == request.auth.uid && request.time >= envelope.unlockAt);
          }
          allow get: if member() && canRead();
          allow create: if member() && validPayload(request.resource.data)
            && !exists(envelopePath()) && existsAfter(envelopePath())
            && validEnvelope(getAfter(envelopePath()).data);
          allow delete: if member() && senderMayCancel(get(envelopePath()).data)
            && !existsAfter(envelopePath());
        }
      }

      // Chỉ các document TRONG subcollection thuộc nhà mới dùng quyền thành viên.
      // Rules v2: {document=**} khớp cả 0 segment, vô tình bao phủ
      // chính /couples/{cid} và vượt qua các ràng buộc membership ở trên.
      // Bắt buộc có ít nhất một collection segment trước đệ quy.
      match /{collection}/{document=**} {
        allow read, write: if collection != 'giftEnvelopes' && collection != 'gifts' && request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
      }
    }
  }
}
