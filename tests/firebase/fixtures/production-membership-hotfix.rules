rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mỗi người chỉ đọc/ghi hồ sơ của chính mình (ghi nhớ mình thuộc nhà nào).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Mã nhà: người đã đăng nhập tra được mã; tạo mới được;
    // chỉ thành viên của nhà đó mới xoá được mã (khi bỏ nhà).
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(resource.data.cid)).data.members;
    }

    // Nhà của hai người.
    match /couples/{cid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      allow update: if request.auth != null && (
        // thành viên sửa thông tin nhà, không đổi danh sách thành viên
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members)
        ||
        // rời nhà: chỉ bỏ đúng mình ra
        (request.auth.uid in resource.data.members
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
          && request.resource.data.code == resource.data.code)
        ||
        // bạn ấy mất tài khoản: người còn lại mời tài khoản cũ ra
        (request.auth.uid in resource.data.members
          && resource.data.members.size() == 2
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.code == resource.data.code)
        ||
        // người thứ hai vào nhà bằng mã: nhà đang có đúng 1 người, chỉ thêm đúng mình
        (resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.code == resource.data.code
          && request.resource.data.roles == resource.data.roles)
      );

      // Chỉ các document TRONG subcollection thuộc nhà mới dùng quyền thành viên.
      // Rules v2: {document=**} khớp cả 0 segment, vô tình bao phủ
      // chính /couples/{cid} và vượt qua các ràng buộc membership ở trên.
      // Bắt buộc có ít nhất một collection segment trước đệ quy.
      match /{collection}/{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/couples/$(cid)).data.members;
      }
    }
  }
}
