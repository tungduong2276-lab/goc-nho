{
  "hosting": {
    "public": "dist/nha3d-preview",
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
